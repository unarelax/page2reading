{
  "manifest_version": 3,
  "name": "Page2Reading",
  "version": "0.2.0",
  "description": "把当前文章导出为可打印 Markdown / PDF（原文 / 中英对照）",
  "action": {
    "default_title": "Page2Reading",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "debugger", "tabs"],
  "host_permissions": ["https://api.deepseek.com/*"]
}
